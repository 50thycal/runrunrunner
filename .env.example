# Required: Neynar API key for Farcaster integration
# Get your API key from https://neynar.com
NEYNAR_API_KEY=

# Required: Private key for the wallet that pays out prizes
# Use a dedicated hot wallet with limited funds
# Format: 0x followed by 64 hex characters
PAYOUT_WALLET_PRIVATE_KEY=

# Required: Secret for authenticating cron job requests
# Generate a random string (e.g., openssl rand -hex 32)
CRON_SECRET=

# Vercel KV (automatically configured when you add Vercel KV to your project)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: Backend URL (for production deployments)
# Update this to match your deployed domain
APP_BACKEND_URL=https://YOUR-DOMAIN.vercel.app

# Optional: OpenAI API key (only if your mini app uses AI features)
# OPENAI_API_KEY=sk-proj-...
